# Copy this file to backend/.env for an explicitly enabled LOCAL demo.
# Demo mode accepts the role selector and must not be enabled on a public deployment.
CREDIT_RISK_DEMO_MODE=1

# For protected deployments, disable demo mode and configure distinct server-side keys.
# Use long randomly generated secrets; never put them in VITE_* variables or commit .env.
# CREDIT_RISK_ROLE_KEYS={"analyst":"<random-secret-at-least-16-chars>","manager":"<different-random-secret-at-least-16-chars>"}

# Optional override. A configured missing path is an error, never a synthetic fallback.
# CREDIT_RISK_DATASET=../Delinquency_prediction_dataset.csv
